{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "affinity": {
            "type": "object",
            "description": "Affinity.",
            "additionalProperties": true
        },
        "baseDomain": {
            "type": "string"
        },
        "bootstrapMode": {
            "type": "object",
            "additionalProperties": true
        },
        "broker": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "audience": {
                    "type": "string",
                    "description": "Broker target that releases the person's GitHub grant (`tokenExchangeBroker.targets.<audience>.grantIssuer`)."
                },
                "clientID": {
                    "type": "string",
                    "description": "This server's client id at muster's token-exchange broker (`tokenExchangeBroker.brokerClients.<id>`, allowed audience `github`)."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the broker client credentials under `client-secret` (and optionally `client-id`) — the same Secret muster's `brokerClients.<id>.clientCredentialsSecretRef` reads. Empty leaves the broker client off."
                }
            }
        },
        "chartOperator": {
            "type": "object",
            "additionalProperties": true
        },
        "ciliumNetworkPolicy": {
            "type": "object",
            "additionalProperties": true
        },
        "circleci": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the CircleCI API token (read scope) under `token`, passed as `CIRCLECI_API_TOKEN`. Empty leaves it unset."
                }
            }
        },
        "cluster": {
            "type": "object",
            "additionalProperties": true
        },
        "clusterCA": {
            "type": "string"
        },
        "clusterCIDR": {
            "type": "string"
        },
        "clusterDNSIP": {
            "type": "string"
        },
        "clusterID": {
            "type": "string"
        },
        "extraArgs": {
            "type": "array",
            "description": "Extra container arguments."
        },
        "extraEnv": {
            "type": "array",
            "description": "Extra environment variables.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    },
                    "valueFrom": {
                        "type": "object",
                        "additionalProperties": true
                    }
                }
            }
        },
        "fullnameOverride": {
            "type": "string",
            "description": "Override the fully qualified app name."
        },
        "gcpProject": {
            "type": "string"
        },
        "githubApp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "apiURL": {
                    "type": "string",
                    "description": "GitHub API base URL; empty is api.github.com."
                },
                "appID": {
                    "type": "integer",
                    "description": "The App used for unattended, read-only inventory reads (the giantswarm-align-files App) and its installation on the org. 0 leaves the App identity off."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the App's PEM private key under `private-key`."
                },
                "installationID": {
                    "type": "integer"
                }
            }
        },
        "global": {
            "type": "object",
            "description": "Platform-wide values an umbrella chart shares with every component and Helm forwards here. `oauth.*` reads the identity contract as its defaults: `global.identity.issuerUrl`, `global.identity.clientId`, `global.identity.existingSecret`, `global.identity.ca.secretName` / `.key`, and `global.domain` for the OAuth base URL. Empty here; a standalone install sets `oauth.*` directly.",
            "additionalProperties": true
        },
        "image": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "pullPolicy": {
                    "type": "string",
                    "description": "Image pull policy."
                },
                "registry": {
                    "type": "string",
                    "description": "Image registry."
                },
                "repository": {
                    "type": "string",
                    "description": "Image repository."
                },
                "tag": {
                    "type": "string",
                    "description": "Image tag. Defaults to the chart appVersion."
                }
            }
        },
        "imagePullSecrets": {
            "type": "array",
            "description": "Image pull secrets."
        },
        "inventory": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "valkeyAddress": {
                    "type": "string",
                    "description": "Address (`host:port`) of the Valkey the inventory lives in, passed to the server as `VALKEY_ADDR`. Empty derives the subchart's Service, `<valkey.valkey.fullnameOverride>.<namespace>.svc:6379`; required when `valkey.enabled` is false."
                }
            }
        },
        "mcp": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "path": {
                    "type": "string",
                    "description": "MCP streamable-HTTP endpoint path."
                }
            }
        },
        "muster": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "mcpServer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "description": {
                            "type": "string",
                            "description": "Human-readable description shown by muster."
                        },
                        "auth": {
                            "type": "object",
                            "description": "How muster authenticates to this server; rendered only with `oauth.enabled`. `forwardToken` makes muster forward the session's Dex id_token byte-identical. `requiredAudiences` are extra audiences that token must carry (the Dex cross-client audience of the platform, e.g. `dex-k8s-authenticator`); they are trusted as bearer audiences by construction.",
                            "additionalProperties": false,
                            "properties": {
                                "forwardToken": {
                                    "type": "boolean"
                                },
                                "requiredAudiences": {
                                    "type": "array"
                                }
                            }
                        },
                        "autoStart": {
                            "type": "boolean",
                            "description": "Start the server connection when muster initializes."
                        },
                        "enabled": {
                            "type": "boolean",
                            "description": "Register this server with muster by rendering an `mcpservers.muster.giantswarm.io` CR in the release namespace. Tools then appear as `x_<name>_<tool>`."
                        },
                        "labels": {
                            "type": "object",
                            "description": "Extra labels on the MCPServer CR.",
                            "additionalProperties": true
                        },
                        "name": {
                            "type": "string",
                            "description": "MCPServer CR name (drives the tool prefix)."
                        }
                    }
                },
                "url": {
                    "type": "string",
                    "description": "muster's base URL as reached from the pod (for example `http://muster.muster.svc:8090`): the broker exchange goes to `<url>/oauth/token`. Empty leaves the broker client off; `get_info` reports it."
                }
            }
        },
        "nameOverride": {
            "type": "string",
            "description": "Override the chart name."
        },
        "nodeSelector": {
            "type": "object",
            "description": "Node selector.",
            "additionalProperties": true
        },
        "oauth": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "allowPublicClientRegistration": {
                    "type": "boolean",
                    "description": "Accept unauthenticated dynamic client registration (labs only)."
                },
                "baseURL": {
                    "type": "string",
                    "description": "Public base URL of this server: the issuer of its own OAuth metadata (https, or http on loopback). Empty derives `https://<fullname>.<global.domain>` when `global.domain` is set."
                },
                "dex": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateURLs": {
                            "type": "boolean",
                            "description": "Let the issuer resolve to a private or loopback address (an in-cluster Dex)."
                        },
                        "caSecret": {
                            "type": "object",
                            "description": "Secret with the CA of a Dex that serves a private certificate; mounted and passed as `DEX_CA_FILE`. Empty name falls back to `global.identity.ca.secretName` / `global.identity.ca.key`.",
                            "additionalProperties": false,
                            "properties": {
                                "key": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            }
                        },
                        "clientID": {
                            "type": "string",
                            "description": "Dex OAuth client ID this server is registered as. Empty falls back to `global.identity.clientId`."
                        },
                        "clientSecret": {
                            "type": "string",
                            "description": "Dex OAuth client secret (prefer `oauth.existingSecret`)."
                        },
                        "issuerURL": {
                            "type": "string",
                            "description": "Dex issuer URL. Empty falls back to `global.identity.issuerUrl`."
                        }
                    }
                },
                "enabled": {
                    "type": "boolean",
                    "description": "Make the server an OAuth 2.1 resource server (mcp-oauth): the MCP endpoint requires a bearer token the platform Dex issued, and every call carries the caller's identity and id_token — the subject token of the broker exchange that releases the caller's GitHub grant. muster forwards the session's id_token byte-identical (MCPServer `auth.forwardToken`, rendered below); it is validated against Dex's JWKS when its audience is in `trustedAudiences`. Off: anonymous — no caller, no grant, tools report so; only for a server nothing but a trusted proxy can reach."
                },
                "existingSecret": {
                    "type": "string",
                    "description": "Existing Secret with the Dex client secret under `dex-client-secret`. Empty falls back to `global.identity.existingSecret`; without that, the chart renders a Secret from `oauth.dex.clientSecret`."
                },
                "sso": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "allowPrivateIPs": {
                            "type": "boolean",
                            "description": "Let the IdP's JWKS endpoint resolve to a private address when validating forwarded tokens (an in-cluster Dex)."
                        }
                    }
                },
                "trustedAudiences": {
                    "type": "array",
                    "description": "OAuth client IDs whose Dex id_tokens are accepted as bearer tokens (SSO token forwarding). Empty falls back to `[global.identity.clientId]`. The server trusts the union of this list and `muster.mcpServer.auth.requiredAudiences`."
                }
            }
        },
        "podAnnotations": {
            "type": "object",
            "description": "Annotations on the pod.",
            "additionalProperties": true
        },
        "podLabels": {
            "type": "object",
            "description": "Labels on the pod.",
            "additionalProperties": true
        },
        "podSecurityContext": {
            "type": "object",
            "description": "Pod security context.",
            "additionalProperties": false,
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "provider": {
            "type": "string"
        },
        "replicaCount": {
            "type": "integer",
            "description": "Number of replicas. The server holds its state in Valkey; more than one is fine."
        },
        "resources": {
            "type": "object",
            "description": "Container resources.",
            "additionalProperties": false,
            "properties": {
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securityContext": {
            "type": "object",
            "description": "Container security context.",
            "additionalProperties": false,
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                },
                "runAsGroup": {
                    "type": "integer"
                },
                "runAsNonRoot": {
                    "type": "boolean"
                },
                "runAsUser": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "type": {
                    "type": "string",
                    "description": "Service type."
                },
                "port": {
                    "type": "integer",
                    "description": "Service port (the container listens on 8080)."
                }
            }
        },
        "serviceAccount": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "annotations": {
                    "type": "object",
                    "description": "Annotations on the ServiceAccount.",
                    "additionalProperties": true
                },
                "create": {
                    "type": "boolean",
                    "description": "Create a ServiceAccount."
                },
                "name": {
                    "type": "string",
                    "description": "ServiceAccount name (generated when empty)."
                }
            }
        },
        "subscriptionID": {
            "type": "string"
        },
        "tolerations": {
            "type": "array",
            "description": "Tolerations.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "effect": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "tolerationSeconds": {
                        "type": "integer"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        },
        "valkey": {
            "type": "object",
            "description": "The inventory store: the Giant Swarm `valkey` app as a subchart (its values live under `valkey.valkey`, the upstream chart's). One replica on an RWO volume with `Recreate`, so a rollout does not deadlock on the volume; the store is a cache — every record is rebuilt from the team files and GitHub — so the restart gap costs nothing. Set `valkey.enabled: false` and `inventory.valkeyAddress` to use a Valkey outside the release.",
            "additionalProperties": true
        }
    }
}
